import java.util.Scanner;

public class Hangman {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        String secret = "java";
        StringBuilder guessed = new StringBuilder("____");
        int attempts = 6;

        while (attempts > 0 && guessed.indexOf("_") >= 0) {
            System.out.println("Word: " + guessed);
            System.out.print("Guess a letter: ");
            char letter = sc.nextLine().toLowerCase().charAt(0);

            boolean found = false;

            for (int i = 0; i < secret.length(); i++) {
                if (secret.charAt(i) == letter) {
                    guessed.setCharAt(i, letter);
                    found = true;
                }
            }

            if (!found) attempts--;
            System.out.println("Attempts left: " + attempts);
        }

        System.out.println(guessed.toString().equals(secret)
                ? "You won!" : "Word was: " + secret);

        sc.close();
    }
}