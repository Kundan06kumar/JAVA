public class MazeGame {
    public static void main(String[] args) {
        char[][] maze = {
                {'S', '.', '#'},
                {'#', '.', '#'},
                {'#', '.', 'E'}
        };

        int row = 0, col = 0;

        int[][] moves = {
                {0, 1},
                {1, 0},
                {1, 0}
        };

        for (int[] move : moves) {
            int nr = row + move[0];
            int nc = col + move[1];

            if (nr >= 0 && nr < maze.length &&
                    nc >= 0 && nc < maze[0].length &&
                    maze[nr][nc] != '#') {
                row = nr;
                col = nc;
            }
        }

        System.out.println("Final position: " + row + ", " + col);
        System.out.println(
                maze[row][col] == 'E' ? "Maze completed!" : "Keep trying!"
        );
    }
}